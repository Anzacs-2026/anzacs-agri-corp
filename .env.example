# Netlify environment variables only — set in Netlify dashboard, never committed with a value

# Brevo — scope: transactional-send-only key (not full-access)
BREVO_API_KEY=

# Supabase — used server-side only, to write server_logs on Brevo failure (anon key cannot insert there)
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
